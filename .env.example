# Copy to .env.local and fill in. Generated automatically by `vercel env pull`
# for DATABASE_URL/BLOB_READ_WRITE_TOKEN once the Neon + Blob integrations
# are connected to the Vercel project — do not hand-write those.

# Neon Postgres (pooled, used at runtime)
DATABASE_URL=

# Neon Postgres (direct/unpooled, used only for drizzle-kit migrations)
DATABASE_URL_UNPOOLED=

# Vercel Blob (logo uploads)
BLOB_READ_WRITE_TOKEN=

# Admin auth (single admin, no public sign-up)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
